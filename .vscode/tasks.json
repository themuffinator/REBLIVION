{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: game (Release x64)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\build_game.ps1",
        "-WorkspaceRoot",
        "${workspaceFolder}",
        "-Configuration",
        "Release",
        "-Platform",
        "x64"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "install: oblivion dev stage",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\install_oblivion_dev.ps1",
        "-WorkspaceRoot",
        "${workspaceFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "build: install oblivion (Release x64)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "build: game (Release x64)",
        "install: oblivion dev stage"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
